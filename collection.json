        {
          "name": "User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Returned user has the correct name\", function () {\r\n    const jsonData = pm.response.json();\r\n    pm.expect(jsonData.name).to.eql(pm.iterationData.get(\"name\"));\r\n});\r\n\r\npm.test(\"Returned user has the correct status\", function () {\r\n    const jsonData = pm.response.json();\r\n    pm.expect(jsonData.status).to.eql(pm.iterationData.get(\"status\"));\r\n});"
                ]
              }
            }
          ],
