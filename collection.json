      "item": [
        {
          "name": "User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jsonData = pm.response.json();\r\n\r\nlet createdUserIds = JSON.parse(\r\n    pm.environment.get(\"createdUserIds\") || \"[]\"\r\n);\r\n\r\ncreatedUserIds.push(jsonData.id);\r\n\r\npm.environment.set(\r\n    \"createdUserIds\",\r\n    JSON.stringify(createdUserIds)\r\n);\r\n\r\npm.environment.set(\"userId\", jsonData.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"name\": \"{{name}}\",\r\n    \"email\": \"{{emailPrefix}}.{{$randomInt}}@example.com\",\r\n    \"gender\": \"{{gender}}\",\r\n    \"status\": \"{{status}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://gorest.co.in/public/v2/users",
              "protocol": "https",
              "host": [
                "gorest",
                "co",
                "in"
              ],
              "path": [
                "public",
                "v2",
                "users"
              ]
            }
          },
          "response": []
